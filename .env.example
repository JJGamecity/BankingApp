# Copy to .env in the project root. Never commit the populated .env file.
# Run your IDE configuration with the project root as its working directory.
BANK_DB_URL=jdbc:postgresql://localhost:5432/bankingData
BANK_DB_USERNAME=bankAppAdmin
BANK_DB_PASSWORD=

# Configure both fields to enable initial admin access.
BANK_SECURITY_ADMIN_USERNAME=
BANK_SECURITY_ADMIN_PASSWORD=

# Optional initial bank representative; normally create staff using an admin.
BANK_SECURITY_REP_USERNAME=
BANK_SECURITY_REP_PASSWORD=

BANK_SECURITY_GOOGLE_ENABLED=false
BANK_SECURITY_GOOGLE_CLIENT_ID=
BANK_SECURITY_GOOGLE_CLIENT_SECRET=

# Used only by the prod profile; local development does not need these.
BANK_TLS_KEYSTORE=
BANK_TLS_KEYSTORE_PASSWORD=
